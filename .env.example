# Use the country calling code followed by digits only. Example for India:
WHATSAPP_PAIR_PHONE=

# Alert recipient. Leave blank to message the paired number (self-chat).
WHATSAPP_ALERT_PHONE=

# CLI/headless delivery only. The macOS widget stores messaging credentials in
# Keychain and provides in-app WhatsApp pairing and Telegram chat discovery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The worker enforces a minimum polling interval of 60 seconds.
NSE_POLL_INTERVAL_SECONDS=60
NSE_LOOKBACK_DAYS=7
NSE_REQUEST_DELAY_MS=300

# PDF extraction and download limits.
PDF_TEXT_LIMIT_CHARS=2200
MAX_PDF_BYTES=25000000

# Analyze extracted announcement PDF text once with the installed Codex CLI.
# Codex CLI must already be installed and authenticated for this macOS user.
CODEX_PDF_ANALYSIS=true
# Optional when `codex` is not on PATH, especially for launchd services.
# CODEX_CLI_PATH=/Users/your-name/.local/bin/codex
